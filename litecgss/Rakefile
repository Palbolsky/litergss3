require 'fileutils'
require_relative 'build/system_env'
require_relative 'build/ruby_installer'
require_relative 'build/sfml_installer'
require_relative 'build/builder'

require 'rake/extensiontask'

CGSS_SFML_VERSION = "2.5.1"
CGSS_RUBY_VERSION_MAIN = "3.0"
CGSS_RUBY_VERSION_MINOR = "0"
CGSS_ARCHITECTURE = "x86"

litecgss_root_dir = File.expand_path(File.dirname(__FILE__))

desc "Configure the project by checking / setting up a working environment"
task :configure, [:buildtype] do |t, args|
    buildtype = args[:buildtype]

    FileUtils.mkdir_p(litecgss_root_dir + "/generated/")
    File.write(litecgss_root_dir + "/generated/build.cache", buildtype)

    Cgss::Builder.cmake_guard()
    Cgss::SfmlInstaller::clean()

    if buildtype.eql? "msvc"
        vs_major_version = Cgss::Builder.check_msvc_compiler()
        puts "Detected VS major version : #{vs_major_version}"
        Cgss::SfmlInstaller.msvc_check_sfml_or_download_and_make_it(CGSS_SFML_VERSION)
    else
        ridk_script = Cgss::RubyInstaller.detect_ridk_or_download_it(CGSS_RUBY_VERSION_MAIN, CGSS_RUBY_VERSION_MINOR, CGSS_ARCHITECTURE)
        Cgss::RubyInstaller.ridk_enable(ridk_script)        
        Cgss::Builder.check_gnu_compiler(CGSS_RUBY_VERSION_MAIN, CGSS_RUBY_VERSION_MINOR, CGSS_ARCHITECTURE)
        Cgss::SfmlInstaller.check_sfml_or_download_and_make_it(CGSS_SFML_VERSION)
    end
    
end

desc "Build the project"
task :compile, [:type] do |t, args|
    buildtype = File.read(litecgss_root_dir + "/generated/build.cache")
    cmake_generator = Cgss::Builder::get_cmake_generator()
    
    ENV["SFML_DIR"] = Cgss::SfmlInstaller::get_sfml_dir()

    if !buildtype.eql? "msvc"
        ridk_script = Cgss::RubyInstaller.ridk_guard()
        Cgss::RubyInstaller.ridk_enable(ridk_script)
    end

    $INCFLAGS << " -I" + (litecgss_root_dir + "/src/src")
    $LDFLAGS << " -L" + (litecgss_root_dir + "/lib")
    
    extra_args = "-DLITECGSS_NO_TEST=True -DCGSS_NO_LOGS=Y -DCMAKE_BUILD_TYPE=Release" if args[:type].eql? "release" 

    puts "Building LiteCGSS in #{litecgss_root_dir}... "
    Dir.chdir(litecgss_root_dir) {
        system("cmake #{cmake_generator} -DBUILD_SHARED_LIBS=True #{extra_args} .")
        system("cmake --build .") or fail "[LiteCGSS] Build failed"
    }
end

desc "Build the project, in release mode"
task :release do
    Rake::Task[:compile].invoke("release")
end

desc "Start unit-tests"
task :test do
    system(litecgss_root_dir + "/bin/LiteCGSS_test") or fail "[LiteCGSS] Tests failed"
end

desc "Clean the project"
task :clean do      
    puts "Cleaning LiteCGSS in #{litecgss_root_dir}... "
    Dir.chdir(litecgss_root_dir) {
        FileUtils.rm_rf litecgss_root_dir + "/lib"
        FileUtils.rm_rf litecgss_root_dir + "/bin"
        FileUtils.rm_rf litecgss_root_dir + "/src/CMakeFiles"
        File.delete("CMakeCache.txt") if File.exists? 'CMakeCache.txt'
    }
end
