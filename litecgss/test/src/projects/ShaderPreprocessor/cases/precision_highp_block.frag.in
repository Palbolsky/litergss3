// Smallest valid fragment shader: exercises the GL_ES precision block in
// isolation. Lives here to document the highp-with-mediump-fallback wiring
// added for large sprite sheets — see kPrecisionBlock in ShaderPreprocessor.cpp.
uniform sampler2D texture;
void main() {
  gl_FragColor = texture2D(texture, gl_TexCoord[0].xy);
}
