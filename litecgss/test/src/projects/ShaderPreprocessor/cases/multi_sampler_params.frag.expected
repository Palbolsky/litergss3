// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
#ifdef GL_ES
varying vec2 v_texture_coordinates;
varying vec2 v_inv_texture_coordinates;
varying vec4 sf_color;
varying vec2 v_factor_npot;
#else
const vec2 v_factor_npot = vec2(1.0, 1.0);
#endif
// Two sampler params in one signature: each gets its own injected companion
// `vec2 <name>_factor_npot`, and the call site injects two matching factor
// arguments at positions 1 and 3 (right after each sampler arg).
uniform sampler2D texture;
uniform sampler2D mask;

// --- per-sampler NPOT factors (auto-generated) ---
#define texture_factor_npot v_factor_npot
uniform vec2 mask_factor_npot;
// -------------------------------------------------
vec4 blend(sampler2D a, vec2 a_factor_npot, sampler2D b, vec2 b_factor_npot, vec2 uv) {
  return texture2D(a, (uv) * a_factor_npot) * texture2D(b, (uv) * b_factor_npot);
}

void main() {
  gl_FragColor = blend(texture, texture_factor_npot, mask, mask_factor_npot, (v_texture_coordinates / v_factor_npot).xy);
}
