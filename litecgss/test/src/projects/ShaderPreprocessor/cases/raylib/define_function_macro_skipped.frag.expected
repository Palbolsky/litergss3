#version 330
// [LiteCGSS::ShaderPreprocessor glsl330]
out vec4 cgss_FragColor;
// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
in vec2 v_texture_coordinates;
in vec2 v_inv_texture_coordinates;
in vec4 sf_color;
in vec2 v_factor_npot;
// Function-like macros are deliberately NOT tracked as aliases. The
// `#define BLEND(a, b)` directive has '(' immediately after the name, so
// alias discovery skips it. The rewriter still sees the underlying
// `texture2D(texture, ...)` call and wraps it normally.
uniform sampler2D texture0;
#define BLEND(a, b) ((a) + (b))

// --- per-sampler NPOT factors (auto-generated) ---
#define texture_factor_npot v_factor_npot
// -------------------------------------------------
void main() {
  cgss_FragColor = BLEND(texture(texture0, ((v_texture_coordinates / v_factor_npot).xy) * texture_factor_npot), vec4(0.0));
}
