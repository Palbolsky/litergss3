#version 330
// [LiteCGSS::ShaderPreprocessor glsl330]
in vec3 vertexPosition;
in vec2 vertexTexCoord;
in vec4 vertexColor;
uniform mat4 mvp;
vec2 position;
vec2 texCoord;
mat4 sf_modelview;
mat4 sf_projection;
vec2 factor_npot;
out vec4 sf_color;
out vec2 v_texture_coordinates;
out vec2 v_inv_texture_coordinates;
// Vertex shaders are passed through unchanged: the engine does not inject
// fragment-only varyings/precision blocks and does not rewrite gl_TexCoord
// or gl_Color here. Verifying this protects map_viewport.vert and friends.
out vec2 v_factor_npot;
void sf_es_main() {
  v_factor_npot = factor_npot;
  gl_Position = sf_projection * sf_modelview * vec4(position, 0.0, 1.0);
}

void main()
{
    position = vertexPosition.xy;
    texCoord = vertexTexCoord;
    sf_modelview = mat4(1.0);
    sf_projection = mvp;
    factor_npot = vec2(1.0, 1.0);
    sf_color = vertexColor;
    v_texture_coordinates = vertexTexCoord;
    v_inv_texture_coordinates = vertexTexCoord;
    v_factor_npot = vec2(1.0, 1.0);
    sf_es_main();
}
