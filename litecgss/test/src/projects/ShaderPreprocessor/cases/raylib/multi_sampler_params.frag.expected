vec4 blend(sampler2D a, vec2 a_factor_npot, sampler2D b, vec2 b_factor_npot, vec2 uv) {
  return texture(a, (uv) * a_factor_npot) * texture(b, (uv) * b_factor_npot);
}

void main() {
  cgss_FragColor = blend(texture0, texture_factor_npot, mask, mask_factor_npot, (v_texture_coordinates / v_factor_npot).xy);
}
