// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
#ifdef GL_ES
varying vec2 v_texture_coordinates;
varying vec2 v_inv_texture_coordinates;
varying vec4 sf_color;
varying vec2 v_factor_npot;
#else
const vec2 v_factor_npot = vec2(1.0, 1.0);
#endif
// `uniform sampler2D foo, bar;` declares two samplers in one statement.
// The token-based discovery picks up both, and each gets its own
// _factor_npot injected: `texture` (primary, by name convention) gets a
// #define against v_factor_npot; `secondary` gets a uniform of its own.
uniform sampler2D texture, secondary;
// --- per-sampler NPOT factors (auto-generated) ---
#define texture_factor_npot v_factor_npot
uniform vec2 secondary_factor_npot;
// -------------------------------------------------
void main() {
  vec4 a = texture2D(texture,   ((v_texture_coordinates / v_factor_npot).xy) * texture_factor_npot);
  vec4 b = texture2D(secondary, ((v_texture_coordinates / v_factor_npot).xy) * secondary_factor_npot);
  gl_FragColor = a + b;
}
