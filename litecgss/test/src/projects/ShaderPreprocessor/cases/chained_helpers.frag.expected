// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
#ifdef GL_ES
varying vec2 v_texture_coordinates;
varying vec2 v_inv_texture_coordinates;
varying vec4 sf_color;
varying vec2 v_factor_npot;
#else
const vec2 v_factor_npot = vec2(1.0, 1.0);
#endif
// `outer` takes a sampler2D param and calls `inner` (also with a sampler2D
// param) passing it through. The companion factor must thread through both
// signatures and both call sites:
//   - outer: signature gets `vec2 s_factor_npot` after `sampler2D s`.
//   - outer's call to inner: gets `s_factor_npot` injected (the factor that
//     now exists in outer's scope thanks to the signature injection).
//   - main's call to outer: gets `texture_factor_npot` injected.
uniform sampler2D texture;

// --- per-sampler NPOT factors (auto-generated) ---
#define texture_factor_npot v_factor_npot
// -------------------------------------------------
vec4 inner(sampler2D s, vec2 s_factor_npot, vec2 uv) {
  return texture2D(s, (uv) * s_factor_npot);
}

vec4 outer(sampler2D s, vec2 s_factor_npot, vec2 uv) {
  return inner(s, s_factor_npot, uv);
}

void main() {
  gl_FragColor = outer(texture, texture_factor_npot, (v_texture_coordinates / v_factor_npot).xy);
}
