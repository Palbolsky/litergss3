// A forward declaration appears before the definition. The signature
// injection must apply to BOTH so the GLSL linker still sees matching
// signatures.
uniform sampler2D texture;

vec4 lookup(sampler2D s, vec2 s_factor_npot, vec2 uv);

// --- per-sampler NPOT factors (auto-generated) ---
#define texture_factor_npot v_factor_npot
// -------------------------------------------------
