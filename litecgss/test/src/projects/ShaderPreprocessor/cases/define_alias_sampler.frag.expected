// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
#ifdef GL_ES
varying vec2 v_texture_coordinates;
varying vec2 v_inv_texture_coordinates;
varying vec4 sf_color;
varying vec2 v_factor_npot;
#else
const vec2 v_factor_npot = vec2(1.0, 1.0);
#endif
// `#define TEX texture` aliases the sampler. The rewriter resolves the alias
// when forming the factor identifier (so we get `texture_factor_npot`, not
// `TEX_factor_npot` which wouldn't exist) but leaves the literal `TEX` in
// the output — the GLSL compiler's own preprocessor expands the macro
// before compilation.
uniform sampler2D texture;
#define TEX texture

// --- per-sampler NPOT factors (auto-generated) ---
#define texture_factor_npot v_factor_npot
// -------------------------------------------------
void main() {
  gl_FragColor = texture2D(TEX, ((v_texture_coordinates / v_factor_npot).xy) * texture_factor_npot);
}
