#version 300 es
precision highp float;
// [LiteCGSS::ShaderPreprocessor glsl330]
out vec4 cgss_FragColor;
// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
in vec2 v_texture_coordinates;
in vec2 v_inv_texture_coordinates;
in vec4 sf_color;
in vec2 v_factor_npot;
// A forward declaration appears before the definition. The signature
// injection must apply to BOTH so the GLSL linker still sees matching
// signatures.
uniform sampler2D texture0;

vec4 lookup(sampler2D s, vec2 s_factor_npot, vec2 uv);

// --- per-sampler NPOT factors (auto-generated) ---
#define texture_factor_npot v_factor_npot
// -------------------------------------------------
void main() {
  cgss_FragColor = lookup(texture0, texture_factor_npot, (v_texture_coordinates / v_factor_npot).xy);
}

vec4 lookup(sampler2D s, vec2 s_factor_npot, vec2 uv) {
  return texture(s, (uv) * s_factor_npot);
}
