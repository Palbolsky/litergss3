#version 300 es
precision highp float;
// [LiteCGSS::ShaderPreprocessor glsl330]
out vec4 cgss_FragColor;
// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
in vec2 v_texture_coordinates;
in vec2 v_inv_texture_coordinates;
in vec4 sf_color;
in vec2 v_factor_npot;
// Precision-qualified sampler declarations are recognized: the discovery
// pass skips the qualifier and picks up `tex` as the sampler name. The
// rewriter wraps calls to it just like an unqualified declaration.
uniform highp sampler2D tex;
// --- per-sampler NPOT factors (auto-generated) ---
#define tex_factor_npot v_factor_npot
// -------------------------------------------------
void main() {
  cgss_FragColor = texture(tex, ((v_texture_coordinates / v_factor_npot).xy) * tex_factor_npot);
}
