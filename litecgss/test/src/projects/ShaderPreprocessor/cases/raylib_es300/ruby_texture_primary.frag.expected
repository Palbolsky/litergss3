#version 300 es
precision highp float;
// [LiteCGSS::ShaderPreprocessor glsl330]
out vec4 cgss_FragColor;
// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
in vec2 v_texture_coordinates;
in vec2 v_inv_texture_coordinates;
in vec4 sf_color;
in vec2 v_factor_npot;
uniform sampler2D rubyTexture;
uniform sampler2D filter_;
// --- per-sampler NPOT factors (auto-generated) ---
#define rubyTexture_factor_npot v_factor_npot
uniform vec2 filter_factor_npot;
// -------------------------------------------------
void main() {
  vec4 a = texture(rubyTexture, ((v_texture_coordinates / v_factor_npot).xy) * rubyTexture_factor_npot);
  vec4 b = texture(filter_, ((v_texture_coordinates / v_factor_npot).xy) * filter_factor_npot);
  cgss_FragColor = mix(a, b, 0.5);
}
