#version 300 es
// [LiteCGSS::ShaderPreprocessor glsl330]
in vec3 vertexPosition;
in vec2 vertexTexCoord;
in vec4 vertexColor;
uniform mat4 mvp;
mat4 sf_modelview;
mat4 sf_projection;
mat4 sf_texture;
vec2 factor_npot;
vec2 position;
vec2 texCoord;
vec4 color;
// PSDK-android's loader background (app/src/main/ruby/loader/layers/
// background.rb): its varyings are written in the GL_ES branch only, the
// desktop one has SFML ES' attributes and nothing else. On raylib, the GL ES
// branch is the one mapped onto raylib's attributes.
out vec4 sf_color;
out vec2 v_texture_coordinates;
out vec2 v_inv_texture_coordinates;
out vec2 v_factor_npot;
void sf_es_main() {
  sf_color = color;
  v_texture_coordinates = (sf_texture * vec4(texCoord, 0.0, 1.0)).xy;
  v_factor_npot = factor_npot;
  gl_Position = sf_projection * sf_modelview * vec4(position.xy, 0.0, 1.0);
}

void main()
{
    sf_modelview = mat4(1.0);
    sf_projection = mvp;
    sf_texture = mat4(1.0);
    factor_npot = vec2(1.0, 1.0);
    position = vertexPosition.xy;
    texCoord = vertexTexCoord;
    color = vertexColor;
    sf_color = vertexColor;
    v_texture_coordinates = vertexTexCoord;
    v_inv_texture_coordinates = vertexTexCoord;
    v_factor_npot = vec2(1.0, 1.0);
    sf_es_main();
}
