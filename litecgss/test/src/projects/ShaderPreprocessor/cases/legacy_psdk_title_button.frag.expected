#version 100
// [LiteCGSS::ShaderPreprocessor processed]
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
precision highp int;
precision highp sampler2D;
#else
precision mediump float;
#endif
#endif
#ifdef GL_ES
varying vec2 v_texture_coordinates;
varying vec2 v_inv_texture_coordinates;
varying vec4 sf_color;
varying vec2 v_factor_npot;
#else
const vec2 v_factor_npot = vec2(1.0, 1.0);
#endif
// Old PSDK (Foret Eternelle) graphics/shaders/title_button.frag: a const array initializer and
// integer arguments to built-ins.
uniform float t;

const vec4 COLORS_0 = vec4(1.0000, 0.1490, 0.2196, 1.0);
const vec4 COLORS_1 = vec4(1.0000, 0.4196, 0.1882, 1.0);
const vec4 COLORS_2 = vec4(1.0000, 0.6353, 0.0078, 1.0);
const vec4 COLORS_3 = vec4(0.0078, 0.8157, 0.5686, 1.0);
const vec4 COLORS_4 = vec4(0.0039, 0.5020, 0.9843, 1.0);
const vec4 COLORS_5 = vec4(0.4824, 0.2118, 0.8549, 1.0);
const vec4 COLORS_6 = vec4(1.0000, 0.1490, 0.2196, 1.0);
vec4 COLORS_at(int sf_index) {
    if (sf_index == 0) return COLORS_0;
    if (sf_index == 1) return COLORS_1;
    if (sf_index == 2) return COLORS_2;
    if (sf_index == 3) return COLORS_3;
    if (sf_index == 4) return COLORS_4;
    if (sf_index == 5) return COLORS_5;
    return COLORS_6;
}
const float PI = 3.1415;

void main() {
  vec2 tc = (v_texture_coordinates / v_factor_npot).xy;
  float circleX = mod((tc.x - t) * 6.0, 1.0);
  float colorIndex = mod((tc.x - t) * 6.0, 6.0);
  vec4 frag = mix(
    COLORS_at(int(floor(colorIndex))),
    COLORS_at(int(floor(colorIndex)) + 1),
    fract(colorIndex)
  );
  float circleRadius = pow(sin(tc.x * PI), 3.0);
  frag.a = 1.0 - (sqrt(pow((tc.y * 2.0 - 1.0) / circleRadius, 2.0) + pow(circleX * 2.0 - 1.0, 2.0)));
  gl_FragColor = frag;
}