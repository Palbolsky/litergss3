{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CGSS_BACKEND": "raylib",
        "LITERGSS_EXT_OUTPUT_DIR": "${sourceDir}/build/${presetName}/lib"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (raylib)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LITECGSS_BUILD_TESTS": "ON",
        "LITECGSS_AGENT": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (raylib)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CGSS_NO_LOGS": "ON"
      }
    },
    {
      "name": "debug-sfml",
      "displayName": "Debug (SFML)",
      "inherits": "debug",
      "cacheVariables": { "CGSS_BACKEND": "sfml" }
    },
    {
      "name": "debug-physfs",
      "displayName": "Debug (raylib, PhysicsFS assets)",
      "inherits": "debug",
      "cacheVariables": {
        "LITECGSS_USE_PHYSFS": "ON"
      }
    },
    {
      "name": "debug-tracy",
      "displayName": "Debug (raylib, Tracy instrumentation)",
      "inherits": "debug",
      "cacheVariables": {
        "LITECGSS_USE_TRACY": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug (raylib, AddressSanitizer + UBSan)",
      "description": "Engine and extension instrumented (LITERGSS_SANITIZE). Tests and the agent tooling preload the ASan runtime into Ruby (cmake/Sanitizers.cmake).",
      "inherits": "debug",
      "cacheVariables": {
        "LITERGSS_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "android",
      "hidden": true,
      "displayName": "Android (embedded, raylib)",
      "description": "Static libLiteRGSS.a + engine for an Android host embedding Ruby. Needs ANDROID_NDK, LITERGSS_RUBY_HDR_DIR, LITERGSS_RUBY_ARCH_HDR_DIR; dependencies in vendor/deps-android-<ABI> (tools/deps/build-deps.sh --android <ABI>) or CMAKE_PREFIX_PATH + CMAKE_FIND_ROOT_PATH.",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CGSS_NO_LOGS": "ON",
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_shared",
        "LITERGSS_EMBEDDED": "ON",
        "LITECGSS_BUILD_TESTS": "OFF",
        "LITECGSS_USE_PHYSFS": "ON",
        "RUBY_HDR_DIR": "$env{LITERGSS_RUBY_HDR_DIR}",
        "RUBY_ARCH_HDR_DIR": "$env{LITERGSS_RUBY_ARCH_HDR_DIR}"
      }
    },
    {
      "name": "android-arm64-v8a",
      "displayName": "Android arm64-v8a (embedded, raylib)",
      "inherits": "android",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (embedded, raylib)",
      "inherits": "android",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    },
    {
      "name": "litecgss",
      "displayName": "LiteCGSS only (no Ruby)",
      "inherits": "debug",
      "cacheVariables": {
        "LITERGSS_BUILD_RUBY_EXT": "OFF",
        "LITECGSS_BUILD_PLAYGROUND": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "debug-sfml", "configurePreset": "debug-sfml" },
    { "name": "debug-physfs", "configurePreset": "debug-physfs" },
    { "name": "debug-tracy", "configurePreset": "debug-tracy" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "litecgss", "configurePreset": "litecgss" },
    { "name": "android-arm64-v8a", "configurePreset": "android-arm64-v8a" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "debug-sfml", "configurePreset": "debug-sfml", "output": { "outputOnFailure": true } },
    { "name": "debug-physfs", "configurePreset": "debug-physfs", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "litecgss", "configurePreset": "litecgss", "output": { "outputOnFailure": true } }
  ]
}
