{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CGSS_BACKEND": "raylib",
        "LITERGSS_EXT_OUTPUT_DIR": "${sourceDir}/build/${presetName}/lib"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (raylib)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LITECGSS_BUILD_TESTS": "ON",
        "LITECGSS_AGENT": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (raylib)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CGSS_NO_LOGS": "ON"
      }
    },
    {
      "name": "debug-sfml",
      "displayName": "Debug (SFML)",
      "inherits": "debug",
      "cacheVariables": { "CGSS_BACKEND": "sfml" }
    },
    {
      "name": "debug-physfs",
      "displayName": "Debug (raylib, PhysicsFS assets)",
      "inherits": "debug",
      "cacheVariables": {
        "LITECGSS_USE_PHYSFS": "ON"
      }
    },
    {
      "name": "debug-tracy",
      "displayName": "Debug (raylib, Tracy instrumentation)",
      "inherits": "debug",
      "cacheVariables": {
        "LITECGSS_USE_TRACY": "ON"
      }
    },
    {
      "name": "litecgss",
      "displayName": "LiteCGSS only (no Ruby)",
      "inherits": "debug",
      "cacheVariables": {
        "LITERGSS_BUILD_RUBY_EXT": "OFF",
        "LITECGSS_BUILD_PLAYGROUND": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "debug-sfml", "configurePreset": "debug-sfml" },
    { "name": "debug-physfs", "configurePreset": "debug-physfs" },
    { "name": "debug-tracy", "configurePreset": "debug-tracy" },
    { "name": "litecgss", "configurePreset": "litecgss" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "debug-sfml", "configurePreset": "debug-sfml", "output": { "outputOnFailure": true } },
    { "name": "debug-physfs", "configurePreset": "debug-physfs", "output": { "outputOnFailure": true } },
    { "name": "litecgss", "configurePreset": "litecgss", "output": { "outputOnFailure": true } }
  ]
}
